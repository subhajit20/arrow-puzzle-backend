# Copy to .env and adjust as needed.

# HTTP / WebSocket port
PORT=3001

# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=vecto_multiplayer

# CORS origin allowed to open a socket (the static game's origin).
# Use "*" for local dev; lock down in production.
CORS_ORIGIN=*

# Countdown duration (ms) between host pressing Start and the board reveal.
COUNTDOWN_MS=3500

# Race time limit (ms). At time-up, unfinished players rank by % cleared.
RACE_DURATION_MS=120000

# Pause between rounds (ms).
ROUND_INTERMISSION_MS=5000

# Rounds-per-game upper bound the host can pick.
MAX_ROUNDS=10

# Each round picks a random board size (from a fixed pool in config.js) and a
# random level in this range. Levels that are multiples of 10 are skipped
# (those produce shaped masks). The level is never shown to players.
RACE_LEVEL_MIN=51
RACE_LEVEL_MAX=300

# Fraction of rounds that use a shaped (milestone) board instead of a plain
# rectangle/square. 0 = never, 1 = always.
RACE_SHAPED_CHANCE=0.35
