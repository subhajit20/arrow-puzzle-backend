# Copy to .env and adjust as needed.

# HTTP / WebSocket port
PORT=3001

# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=vecto_multiplayer

# CORS origin allowed to open a socket (the static game's origin).
# Use "*" for local dev; lock down in production.
CORS_ORIGIN=*

# Countdown duration (ms) between host pressing Start and the board reveal.
COUNTDOWN_MS=3500

# Race time limit (ms). At time-up, unfinished players rank by % cleared.
RACE_DURATION_MS=120000

# Race board dimensions / difficulty level.
# Avoid multiples of 10 for RACE_LEVEL — those trigger milestone shaped masks.
RACE_ROWS=48
RACE_COLS=28
RACE_LEVEL=79
